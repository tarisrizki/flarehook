  "homepage": "https://github.com/tarisrizki/flarehook#readme",
  "bugs": "https://github.com/tarisrizki/flarehook/issues",
  "dependencies": {
    "picocolors": "^1.1.1",
    "qrcode-terminal": "^0.12.0",
    "untun": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode-terminal": "^0.12.2",
