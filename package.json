{
  "name": "flarehook",
  "version": "1.0.0",
  "description": "Zero-config Cloudflare Tunnel with Webhook Inspector & HMAC Re-Signer",
  "type": "module",
  "bin": {
    "flarehook": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
